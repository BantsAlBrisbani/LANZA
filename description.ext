class CfgFunctions
{
    //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Loadout Management ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~//

    class TAG
    {
        class Loadout
        {
            file = "Functions\Loadout";

            class setLoadout {};
            class saveDeathLoadout {};
            class restoreDeathLoadout {};
        };
    };

    //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Respawn Ticket System - Point 1 Only ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~//

    class TCK
    {
        class tickets
        {
            file = "functions\tickets";

            class requestSpawnTicket {};
            class refreshRespawnPosition {};

            class sendClassMessage {};
            class receiveClassMessage {};
        };
    };
};

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ CfgRemoteExec ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~//

class CfgRemoteExec
{
    class Functions
    {
        mode = 1;
        jip = 0;

        class TCK_fnc_requestSpawnTicket
        {
            allowedTargets = 2; // server only
            jip = 0;
        };

        class TCK_fnc_receiveClassMessage
        {
            allowedTargets = 0;
            jip = 0;
        };
    };
};
