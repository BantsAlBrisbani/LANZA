		class Item155
		{
			dataType="Comment";
			class PositionInfo
			{
				position[]={14792.43,17.91,16692.17};
			};
			title="Conversations/Add Action";
			description="This is for creating the option for players to have conversations with an AI and/or add an action to an object so that it is interactable.  " \n " " \n "- Read the instructions in the J2-mission making guide regarding this. " \n " " \n "- Add the script in the example AI to the object or AI you want in your mission.  " \n " " \n "- Edit the details within it to suit what you want. " \n " " \n "- Done! " \n "" \n "There is an AI character here as an example of 3 actions/conversattions with him, with the last options spawning some markers. " \n "" \n "There is also an example of a laptop which you could use to add an intel collection option. ";
			id=1302;
		};
		class Item156
		{
			dataType="Group";
			side="Civilian";
			class Entities
			{
				items=1;
				class Item0
				{
					dataType="Object";
					class PositionInfo
					{
						position[]={14795.088,17.911438,16692.115};
						angles[]={0,5.4354267,0};
					};
					side="Civilian";
					flags=7;
					class Attributes
					{
						init="call{if (isServer) then {[this, ""Talk to distressed villager"", ""\a3\ui_f\data\IGUI\Cfg\holdactions\holdAction_connect_ca.paa"", ""\a3\ui_f\data\IGUI\Cfg\holdactions\holdAction_connect_ca.paa"", ""_this distance _target < 3"", ""_caller distance _target < 3"", { hint ""Talking"" }, {}, { [""Distressed Naudeh Villager - What happened to my brother and his friends? You were meant to help them but you bring them back dead. Why did this happen?""] remoteExec [""systemChat"",group _caller]; hint ""Explain why they died"" }, { hint ""Conversation interrupted"" }, [], 12, nil, true, false] remoteExec [""BIS_fnc_holdActionAdd"", 0, true]; }, " \n " " \n "if (isServer) then {[this, ""Explain why they died"", ""\a3\ui_f\data\IGUI\Cfg\holdactions\holdAction_connect_ca.paa"", ""\a3\ui_f\data\IGUI\Cfg\holdactions\holdAction_connect_ca.paa"", ""_this distance _target < 3"", ""_caller distance _target < 3"", { hint ""Talking"" }, {}, { [""Distressed Naudeh Villager - I guess you did everything you could. We appreciate you bringing their bodies home. At least this way we can give them the proper burial they deserve, not the mass grave that the Russians are using. You can leave all 6 bodies here if you like. I will make sure they get to my friends families. My name is Khalil Anwari by the way, but you may call me Khali""] remoteExec [""systemChat"",group _caller]; hint ""The villager is upset but appreciative"" }, { hint ""Conversation interrupted"" }, [], 5, nil, true, false] remoteExec [""BIS_fnc_holdActionAdd"", 0, true]; }, " \n " " \n "if (isServer) then {[this, ""Ask Khali about the dead civilians from the accident"", ""\a3\ui_f\data\IGUI\Cfg\holdactions\holdAction_connect_ca.paa"", ""\a3\ui_f\data\IGUI\Cfg\holdactions\holdAction_connect_ca.paa"", ""_this distance _target < 3"", ""_caller distance _target < 3"", { hint ""Asking if he knows the names of the deceased civilians in the accident."" }, {}, { _myMarker8 = createMarker [""NAME"",[8698.96,4907.63]]; _myMarker8 setMarkerText ""See the father of the deceased men.""; _myMarker8 setMarkerType ""hd_unknown""; _myMarker8 setMarkerColor ""colorCivilian""; [""Khali - I do know the father of these young men. Their house is not far from here. Just keep following the road to the south east and you will see it on your right. They live in a 2 story house. His name is Abdul-Qadir Saikal.""] remoteExec [""systemChat"",group _caller]; hint ""House location marked on map."" }, { hint ""Conversation interrupted"" }, [], 12, nil, true, false] remoteExec [""BIS_fnc_holdActionAdd"", 0, true]; }, " \n "}";
					};
					id=1304;
					type="C_man_1";
					class CustomAttributes
					{
						class Attribute0
