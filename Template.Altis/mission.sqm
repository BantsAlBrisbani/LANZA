		class Item151
		{
			dataType="Trigger";
			position[]={14825.895,17.91,16717.084};
			angle=0.7964983;
			class Attributes
			{
				condition="call{this}";
				onActivation="call{gate_1 animate [""Door_1_rot"", 1] " \n "}";
				onDeactivation="call{gate_1 animate [""Door_1_rot"", 0]}";
				sizeA=7.2989998;
				sizeB=5.1729999;
				sizeC=3;
