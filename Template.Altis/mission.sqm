		class Item297
		{
			dataType="Comment";
			class PositionInfo
			{
				position[]={14861.766,17.882999,16663.65};
			};
			title="EN Artillery";
			description="- This set up needs to be used for any EN artillery that you want to be used by the Zeus's. " \n "" \n "- You can use most types of turrets or artillery pieces except for really modern ones like the CSAT mortars. I would recommend you stick to using ones similar to the examples given. " \n "" \n "- You need to have the following in the unit's init. " \n "" \n "this addEventHandler [""Fired"",{(_this select 0) setVehicleAmmo 1}];" \n "this setVariable ['lambs_danger_disableAI', true]" \n "" \n "- Once that script is in the init, place down the werthless ignore module and then sync the units to that module. That will prevent the unit transferring to the headless clients. " \n "" \n "- Done. " \n "" \n "- NOTE: If you play this mission as is, then the EN may dismount and engage you. Just be aware. ";
			id=8152;
			atlOffset=-0.00035667419;
		};
