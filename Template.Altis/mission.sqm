		class Item9
		{
			dataType="Comment";
			class PositionInfo
			{
				position[]={14790.584,17.851,16571.469};
				angles[]={6.2805333,3.9981122,0.0013372133};
			};
			title="CBRN";
			description="The instructions can be found here but I'll try to summarise it for you. " \n "" \n "I highly recommend you read the link below to get an idea of how to edit the settings." \n "" \n "https://forums.bohemia.net/forums/topic/225668-cbrn-script/" \n "" \n "To create a CBRN area you need to place down an area marker, either round or retangular and name it cbrn1, cbrn2, cbrn3. Depending on which one you use will determine the strength of the gas. (1 being lowest, 3 being highest) These can be changes in the .sqf if required." \n "" \n "You then need to make the marker completely see-through, unless you want it to show on the map. When players walk into that area, they will start to get affected by the gas. " \n "" \n "This may be tricky so if you need a hand, ask me and I'll run you through it. ";
			id=667;
			atlOffset=-0.00036621094;
		};
		class Item10
		{
			dataType="Marker";
			position[]={14783.75,17.860001,16577.213};
			name="cbrn3";
			text="This marker indicates the gas area. Make this invisibile if you don't want players to see it. You do this by turning down the alpha setting to 0% in this window below. ";
			markerType="ELLIPSE";
			type="ellipse";
			colorName="ColorRed";
			a=15;
			b=15;
			id=670;
		};
