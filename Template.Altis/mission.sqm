		class Item7
		{
			dataType="Comment";
			class PositionInfo
			{
				position[]={14769.719,17.857,16558.068};
				angles[]={6.2818937,3.9981122,0};
			};
			title="Radio Jamming";
			description="The instructions can be found here but I'll try to summarise it for you. " \n "" \n "https://forums.bohemia.net/forums/topic/203810-release-radio-jamming-script-for-task-force-radio/" \n "" \n "To create a radio jamming object or vehicle, simply place down the object/vehicle which you want to be the jammer, and  change the variable name to something like Jammer1. This is already the default one in the initplayerlocal.sqf file so if you place down an object and name it Jammer1, it will work automatically for you. " \n "" \n "If you wish to create multiple jammers, then you create a second object and name it Jammer2, then add Jammer2 after the Jammer1 text in the initplayerlocal.sqf file. " \n "" \n "This may be tricky so if you need a hand, ask me and I'll run you through it. ";
			id=664;
			atlOffset=-0.00042724609;
		};
		class Item8
